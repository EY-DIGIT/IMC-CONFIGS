{
  "key": "tlcertificate",
  "config": {
      "defaultStyle": {
          "font": "Cambay"
           },
           
      "pageMargins": [26, 20, 18, 15],

           
          "content": [
            
{
    "image": "{{logoImage}}",
    "width": 200,
    "absolutePosition": { "x": 200, "y": 320 }
  },
  
{
    "image": "{{logoImage}}",
    "width": 50,
    "alignment": "center",
    "margin": [0, 0, 0, 6],
    "opacity": 1
  },



            {
  "alignment": "center",
  "stack": [
    {
      "text": "Indore Nagar Nigam",
      "fontSize": 16,
      "bold": true,
      "color": "#E06C2B",
      "margin": [0, 5, 0, 2]
    },
    {
      "text": "Trade License Certificate",
      "fontSize": 14,
      "bold": true,
      "color": "#000000",
      "margin": [0, 2, 0, 2]
    },
    {
      "text": "Issued under Section 366 and 427 of the Municipal Corporation Act, 1956",
      "fontSize": 12,
      "color": "#555555",
      "margin": [0, 2, 0, 3]
    },
    {
      "text": "0437 : Barhi Nagar Parishad",
      "fontSize": 13,
      "bold": true,
      "color": "#000000",
      "margin": [0, 3, 0, 2]
    },
    {
      "text": "2025 - 26",
      "fontSize": 12,
      "color": "#555555",
      "margin": [0, 2, 0, 10]
    }
  ],
  "margin": [0, 0, 0, 0]
},
{
  "table": {
    "widths": ["33%", "33%", "34%"],
    "body": [
      [
        { "text": "Firm Name", "bold": true, "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] },
        { "text": "Registration ID", "bold": true, "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] },
        { "text": "License Validity", "bold": true, "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] }
      ],
      [
        { "text": "firmName", "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] },
        { "text": "registrationId", "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] },
        {
          "stack": [
            { "text": "From DD-MM-YYYY", "alignment": "center" },
            { "text": "To DD-MM-YYYY", "alignment": "center" }
          ],
          "margin": [0, 4, 0, 4],
          "fillColor": "#D0D0D0"
        }
      ]
    ]
  },
  "layout": "lightHorizontalLines",
  "margin": [0, 0, 0, 5]
},
{
  "table": {
    "widths": ["25%", "25%", "25%", "25%"],
    "body": [
      [
        { "text": "Applicant Name", "bold": true, "alignment": "center" },
        { "text": "{{applicantname}}" },
        { "text": "Application Date", "bold": true, "alignment": "center" },
        { "text": "{{applicationDate}}" }
      ],
      
      [ { "text": "", "colSpan": 4, "margin": [0, 3, 0, 3] }, {}, {}, {} ],

      [
        { "text": "S/O", "bold": true, "alignment": "center" },
        { "text": "{{fatherHusbandName}}" },
        { "text": "Serial No.", "bold": true, "alignment": "center" },
        { "text": "serialNo" }
      ],
      
      [ { "text": "", "colSpan": 4, "margin": [0, 3, 0, 3] }, {}, {}, {} ],

      [
        { "text": "Firm Type", "bold": true, "alignment": "center" },
        { "text": "firmType" },
        { "text": "Trade Type", "bold": true, "alignment": "center" },
        { "text": "{{tradeType}}" }
      ],
      
      [ { "text": "", "colSpan": 4, "margin": [0, 3, 0, 3] }, {}, {}, {} ],

      [
        { "text": "Zone", "bold": true, "alignment": "center" },
        { "text": "{{zone}}" },
        { "text": "Ward", "bold": true, "alignment": "center" },
        { "text": "{{ward}}" }
      ],
      
      [ { "text": "", "colSpan": 4, "margin": [0, 3, 0, 3] }, {}, {}, {} ],

      [
        { "text": "Total Fee", "bold": true, "alignment": "center" },
        { "text": "₹ totalFee" },
        { "text": "Address", "bold": true, "alignment": "center" },
        { "text": "{{address}}" }
      ]
    ]
  },
  "layout": "noBorders",
  "margin": [0, 8, 0, 10]
},
{
  "text": "TRADE TYPE",
  "bold": true,
  "margin": [0, 10, 0, 6]
},
{
  "table": {
    "widths": ["20%", "20%", "20%", "20%", "20%"],
    "body": [
      [
        { "text": "Item Code", "bold": true, "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] },
        { "text": "Description", "bold": true, "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] },
        { "text": "Quantity", "bold": true, "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] },
        { "text": "Rate", "bold": true, "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] },
        { "text": "Amount", "bold": true, "alignment": "center", "fillColor": "#D0D0D0", "margin": [0, 8, 0, 8] }
      ],
      [
        { "text": "{{itemCode}}", "alignment": "center", "margin": [0, 8, 0, 8] },
        { "text": "{{description}}", "alignment": "center", "margin": [0, 8, 0, 8] },
        { "text": "{{quantity}}", "alignment": "center", "margin": [0, 8, 0, 8] },
        { "text": "₹ {{rate}}", "alignment": "center", "margin": [0, 8, 0, 8] },
        { "text": "₹ {{amount}}", "alignment": "center", "margin": [0, 8, 0, 8] }
      ]
    ]
  },
  "layout": "lightHorizontalLines",
  "margin": [0, 0, 0, 10],
  "fillColor": "#D0D0D0"

},
{
  "text": "NOTES",
  "bold": true,
  "fontSize": 9,
  "margin": [0, 5, 0, 6]
},
{
  "ol": [
    "The license must be presented upon inspection by the authorized officer of the Municipal Corporation.",
    "It is mandatory to obtain a new license in case of a change in the location or name of the business.",
    "The license is issued only where the policy/rules/regulations of the concerned policy/council permit it.",
    "Essential information/documents will be considered missing, and appropriate legal action will be taken if they are not provided.",
    "The department will not be responsible for any disputes related to rent, guarantee, and ownership.",
    "If the business is closed, the license/cancellation application must be submitted; otherwise, it will be mandatory.",
    "Compliance with rules and instructions issued from time to time by the administration and the department is mandatory.",
    "The conditions for compliance with the applicable laws/regulations on the licensed business are issued from time to time.",
    "The license is issued subject to compliance with the provisions of the relevant laws of the Cigarettes and Other Tobacco Products Act, 2003, and the Smoke-Free Public Places Rules, 2008."
  ],
  "fontSize": 7,
  "margin": [0, 0, 0, 10]
},
{
  "margin": [0, 10, 0, 10],
  "stack": [
    {
      "image": "{{qr_code_image}}",
      "width": 50,
      "height": 50,
      "alignment": "left",
      "margin": [0, 0, 0, 6]
    }
  ]
}

             
            
           ]
           
         }
      }