{
  "key": "pt-demandnote",
  "config": {
    "pageSize": "A4",
    "pageMargins": [30, 15, 30, 15],
    "defaultStyle": { "font": "Cambay" },
    "content": [

      {
        "image": "{{logoImage}}",
        "width": 400,
        "absolutePosition": { "x": 100, "y": 150 }
      },
      {
        "columns": [
          { "text": "Demand Note u/s 173", "style": "topline" },
          { "text": "{{paymentDate}}", "alignment": "right", "style": "topline" }
        ],
        "margin": [0, 0, 0, 10]
      },

      {
        "alignment": "center",
        "stack": [
          { "text": "Indore Municipal Corporation", "style": "header-title", "fontsize": 13 },
          { "text": "Demand Notice Under Section 173", "style": "header-subtitle", "fontsize": 12 }
          
        ],
        "margin": [0, 0, 0, 10]
      },

  
{
  "text": "Assessment Year: {{assessmentYear}}",
  "fontSize": 9,
  "bold": true,
  "margin": [0, 0, 0, 8]
},


     {
  "style": "infoTable",
  "margin": [0, 10, 0, 10],
  "table": {
    "widths": ["15%", "20%", "15%", "20%", "15%", "15%"],
    "body": [
      [
        { "text": "Property ID", "style": "th" },
        { "text": "{{consumerID}}", "style": "td" },
        { "text": "Old Property ID", "style": "th" },
        { "text": "{{oldpropertyid}}", "style": "td" },
        { "text": "Connection Date", "style": "th" },
        { "text": "{{paymentDate}}", "style": "td" }
      ],
      [
        { "text": "Owner Name", "style": "th" },
        { "text": "{{payerName}}", "colSpan": 3, "style": "td" },
        {},
        {},
        { "text": "Mobile No", "style": "th" },
        { "text": "{{payerContact}}", "style": "td" }
      ],
      [
        { "text": "Address", "style": "th" },
        { "text": "{{ptAddress}}", "colSpan": 3, "style": "td" },
        {}, 
        {},
        { "text": "Rate Zone", "style": "th" },
        { "text": "{{rateZone}}", "style": "td" }

      ],
      [
        { "text": "Road Factor", "style": "th" },
        { "text": "{{roadFactor}}", "style": "td" },
        { "text": "Exemption", "style": "th" },
        { "text": "{{exemption}}", "style": "td" },
        { "text": "Essential Tax", "style": "th" },
        { "text": "{{essentialTax}}", "style": "td" }      
        
      ],
      [
        { "text": "Other Factor", "style": "th" },
        { "text": "Mobile Tower: {{mobileTower}} ; Advertisement: {{advertisement}} ; Bond Road: {{bondRoad}} ", "colSpan": 3, "style": "td" },
        {}, {}, 
        { "text": "Date", "style": "th" },
        { "text": "{{paymentDate}}",  "style": "td" }

      ]
    ]
  }
},



      {
  "style": "calcTable",
  "margin": [0, 0, 0, 10],
  "table": {
    "widths": ["14%", "15%", "9%", "14%", "9%", "8%", "9%", "14%", "8%"],
    "headerRows": 2,
    "keepWithHeaderRows": 1,
    "dontBreakRows": true,
    "body": [
      [
        {
          "text": "Dimension Details",
          "style": "tableHeader",
          "colSpan": 9,
          "alignment": "center",
          "bold": true,
          "fillColor": "#DAE1F3"
        },
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {}
      ],
      [
        { "text": "{{th_usage_type}}", "style": "th" },
        { "text": "{{th_usage_factor}}", "style": "th" },
        { "text": "{{th_floor_no}}", "style": "th" },
        { "text": "{{th_construction_type}}", "style": "th" },
        { "text": "Area (Sq. ft.)", "style": "th" },
        { "text": "{{th_rate}}", "style": "th" },
        { "text": "{{th_alv}}", "style": "th" },
        { "text": "{{th_maintenance}}", "style": "th" },
        { "text": "{{th_tpv}}", "style": "th" }
      ],
      "{{#calcTableData}}[{\"text\":\"{{calc_usageType}}\",\"style\":\"td\"},{\"text\":\"{{calc_usageFactor}}\",\"style\":\"td\"},{\"text\":\"{{calc_floorNo}}\",\"style\":\"td\"},{\"text\":\"{{calc_constructionType}}\",\"style\":\"td\"},{\"text\":\"{{calc_area}}\",\"style\":\"td\"},{\"text\":\"₹ {{calc_rate}}\",\"style\":\"td\"},{\"text\":\"₹ {{calc_alv}}\",\"style\":\"td\"},{\"text\":\"₹ {{maintainance_discount}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_tpv}}\",\"style\":\"td\"}]{{/calcTableData}}"
    ]
  },
  "layout": {}
},
{
  "style": "TaxTable",
  "margin": [0, 0, 0, 10],

  "table": {
    "widths": ["25%", "25%", "25%", "25%"],
    "headerRows": 2,
    "keepWithHeaderRows": 1,
    "dontBreakRows": true,
    "body": [
      [

        {

          "text": "Summary Ledger",

          "style": "tableHeader",

          "colSpan": 4,

          "alignment": "center",

          "bold": true,

          "fillColor": "#DAE1F3"

        },

        {},

        {},

        {}

      ],
      [
        { "text": "Year", "style": "th" },
        { "text": "Demand", "style": "th" },
        { "text": "Collection/Paid", "style": "th" },
        { "text": "Cumulative Balance", "style": "th" }
      ],
      "{{#taxTableData}}[{\"text\":\"{{tax_year}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_netTotal}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_paid}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_cumulative}}\",\"style\":\"td\"}]{{/taxTableData}}"
    ]
  },
  "layout": {}
},
{
        "style": "newtaxTable",
        "table": {
          "widths": ["7%", "8%", "8%", "9%", "6%", "8%", "13%", "8%", "8%", "8%", "8%","9%"],
          "headerRows": 2,
          "keepWithHeaderRows": 1,
          "dontBreakRows": true,
          "body": [
            [
        {
          "text": "Tax Details",
          "style": "tableHeader",
          "colSpan": 12,
          "alignment": "center",
          "bold": true,
          "fillColor": "#DAE1F3"
        },
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {}
      ],

            [
              { "text": "{{th_year}}", "style": "th" },
              { "text": "{{th_property_tax}}", "style": "th" },
              { "text": "{{th_samekit_tax}}", "style": "th" },
              { "text": "{{th_education_cess}}", "style": "th" },
              { "text": "{{th_water_cess}}", "style": "th" },
              { "text": "{{th_drainage_cess}}", "style": "th" },
              { "text": "{{th_urban_dev_cess}}", "style": "th" },
              { "text": "{{th_service_charge}}", "style": "th" },
              { "text": "{{th_total_tax}}", "style": "th" },
              { "text": "{{th_rebate}}", "style": "th" },
              { "text": "{{th_penalty}}", "style": "th" },
              { "text": "{{th_net_total}}", "style": "th" }
            ],
            "{{#newtaxTableData}}[{\"text\":\"{{tax_year}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_propertyTax}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_samekitTax}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_educationCess}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_waterCess}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_drainageCess}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_urbanDevCess}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_serviceCharge}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_totalTax}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_rebate}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_penalty}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_netTotal}}\",\"style\":\"td\"}]{{/newtaxTableData}}"
          ]
        },
        "layout": {}
      },
{
  "margin": [0, 8, 0, 8],
  "table": {
    "widths": ["25%", "25%", "25%", "25%"],
    "body": [
      [
        {
          "text": "Arrear: ₹ {{arrearAmt}}",
          "bold": true,
          "fontSize": 8,
          "fillColor": "#FAE3D5",
          "lineHeight": 1.1,
          "margin": [6, 4, 6, 4]
        },
        {
          "text": "Current Year Net Tax: ₹ {{currentYearNetTax}}",
          "bold": true,
          "fontSize": 8,
          "fillColor": "#FAE3D5",
          "lineHeight": 1.1,
          "margin": [6, 4, 6, 4]
        },
        {
          "text": "Previous Balance: ₹ {{previousBalance}}",
          "bold": true,
          "fontSize": 8,
          "fillColor": "#FAE3D5",
          "lineHeight": 1.1,
          "margin": [6, 4, 6, 4]
        },
        {
          "text": "Total Payable Amount: ₹ {{totalDemandPayable}}",
          "bold": true,
          "fontSize": 8,
          "fillColor": "#FAE3D5",
          "lineHeight": 1.1,
          "margin": [6, 4, 6, 4]
        }
      ]
    ]
  },
  "layout": "noBorders"
},


{
  "text": "Terms & Condition:",
  "bold": true,
  "fontSize": 11,
  "margin": [0, 20, 0, 6]
},
{
  "ol": [
    "आप इस देयक प्राप्ति से 15 दिवस के अन्दर उक्त राशि का भुगतान करें अन्यथा म.प्र. नगर पालिका अधिनियम 1956 की धारा 174/175 के तहत वसूली की सख्त कार्यवाही की जायेगी|",
    "उपर्युक्त देयक का भुगतान यदि आपके द्वारा निगम कोष में जमा किया गया है तो उक्त देयक निरस्त माना जायेगा|",
    "अनुरोध है कि भुगतान के समय अपना मोबाइल क्रमांक अवश्य दें जिससे कि भुगतान की जानकारी आपको एसएमएस के द्वारा दी जा सके|",
    "समस्त प्रकार के करों / सेवा शुल्कों / देयों का भुगतान नगर निगम / नगर परिषद / नगर पालिका के कैश काउंटर पर अथवा सहायक राजस्व निरीक्षक के पास नकद, UPI, चेक, डिमांड ड्राफ्ट (DD), NEFT, RTGS तथा क्रेडिट/डेबिट कार्ड के माध्यम से किया जा सकता है।"
  ],
  "fontSize": 9,
  "margin": [0, 0, 0, 10]
},


