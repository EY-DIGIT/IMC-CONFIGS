{
  "key": "property-receipt",
  "config": {
    "pageSize": "A4",
    "pageMargins": [24, 22, 24, 22],

    "background": {
      "image": "{{logoImage}}",
      "opacity": 0.06,
      "width": 520
    },

    "defaultStyle": { "font": "Cambay" },

    "content": [
      {
        "alignment": "center",
        "stack": [
          { "image": "{{logoImage}}", "width": 48, "height": 48, "margin": [0, 0, 0, 6] },
          { "text": "{{logo-header}} {{Municipal_Corporation}}", "style": "header-title" },
          { "text": "{{serviceType}} {{payment_receipt}}", "style": "header-subtitle" },
          {
            "text": "{{address}} • {{phoneNumber}} • {{website}} • {{email}}",
            "style": "header-meta",
            "margin": [0, 4, 0, 0]
          }
        ],
        "margin": [0, 0, 0, 8]
      },

      {
        "style": "meta-table",
        "table": {
          "widths": ["27%", "23%", "27%", "23%"],
          "headerRows": 0,
          "dontBreakRows": true,
          "body": [
            [
              { "text": "{{receipt_no}}:", "style": "meta-label" },
              { "text": "{{receiptNo}}",   "style": "meta-value" },
              { "text": "{{payment_date}}:", "style": "meta-label" },
              { "text": "{{paymentDate}}", "style": "meta-value" }
            ],
            [
              { "text": "{{payer_name}}:", "style": "meta-label" },
              { "text": "{{payerName}}",   "style": "meta-value" },
              { "text": "{{consumer_id}}:", "style": "meta-label" },
              { "text": "{{consumerID}}",  "style": "meta-value" }
            ],
            [
              { "text": "{{payer_contact}}:", "style": "meta-label" },
              { "text": "{{payerContact}}",    "style": "meta-value" },
              { "text": "{{payment_status}}:", "style": "meta-label" },
              { "text": "{{paymentStatus}}",   "style": "meta-value" }
            ],
            [
              { "text": "{{payment_mode}}:", "style": "meta-label" },
              { "text": "{{paymentMode}}",   "style": "meta-value" },
              { "text": "{{transaction_id}}:", "style": "meta-label" },
              { "text": "{{transactionID}}",   "style": "meta-value" }
            ],
            [
              { "text": "{{g8_receipt_no}}:", "style": "meta-label" },
              { "text": "{{G8ReceiptNo}}",     "style": "meta-value" },
              { "text": "{{g8_receipt_date}}:", "style": "meta-label" },
              { "text": "{{G8ReceiptDate}}",    "style": "meta-value" }
            ],
            [
              { "text": "{{service_type}}:", "style": "meta-label" },
              { "text": "{{serviceType}}",   "style": "meta-value" },
              { "text": "{{billing_period}}:", "style": "meta-label" },
              { "text": "{{fromPeriod}} {{to}} {{toPeriod}}", "style": "meta-value" }
            ]
          ]
        },
        "layout": {},
        "margin": [0, 6, 0, 4]
      },

      { "text": "{{calcTableTitle}}", "style": "section-title", "margin": [0, 10, 0, 6] },
      {
        "style": "calcTable",
        "table": {
          "widths": ["12%", "10%", "10%", "16%", "10%", "10%", "10%", "11%", "11%"],
          "headerRows": 1,
          "keepWithHeaderRows": 1,
          "dontBreakRows": true,
          "body": [
            [
              { "text": "{{th_usage_type}}", "style": "th", "noWrap": true },
              { "text": "{{th_usage_factor}}", "style": "th", "noWrap": true },
              { "text": "{{th_floor_no}}", "style": "th", "noWrap": true },
              { "text": "{{th_construction_type}}", "style": "th", "noWrap": true },
              { "text": "{{th_area}}", "style": "th", "noWrap": true },
              { "text": "{{th_rate}}", "style": "th", "noWrap": true },
              { "text": "{{th_alv}}", "style": "th", "noWrap": true },
              { "text": "{{th_maintenance}}", "style": "th", "noWrap": true },
              { "text": "{{th_tpv}}", "style": "th", "noWrap": true }
            ],
            [
              { "text": "{{calc1_usageType}}",      "style": "td" },
              { "text": "{{calc1_usageFactor}}",    "style": "td", "alignment": "right" },
              { "text": "{{calc1_floorNo}}",        "style": "td", "alignment": "center" },
              { "text": "{{calc1_constructionType}}","style": "td" },
              { "text": "{{calc1_area}}",           "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{calc1_rate}}",           "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{calc1_alv}}",            "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{calc1_maintenance}}",    "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{calc1_tpv}}",            "style": "td", "alignment": "right", "font": "Roboto" }
            ]
          ]
        },
        "layout": {}
      },

      { "text": "{{taxTableTitle}}", "style": "section-title", "margin": [0, 10, 0, 6] },
      {
        "style": "taxTable",
        "table": {
          "widths": ["8%", "9%", "11%", "10%", "10%", "11%", "10%", "10%", "10%", "7%", "7%", "12%"],
          "headerRows": 1,
          "keepWithHeaderRows": 1,
          "dontBreakRows": true,
          "body": [
            [
              { "text": "{{th_year}}", "style": "th", "noWrap": true },
              { "text": "{{th_property_tax}}", "style": "th", "noWrap": true },
              { "text": "{{th_samekit_tax}}", "style": "th", "noWrap": true },
              { "text": "{{th_education_cess}}", "style": "th", "noWrap": true },
              { "text": "{{th_water_cess}}", "style": "th", "noWrap": true },
              { "text": "{{th_drainage_cess}}", "style": "th", "noWrap": true },
              { "text": "{{th_urban_dev_cess}}", "style": "th", "noWrap": true },
              { "text": "{{th_service_charge}}", "style": "th", "noWrap": true },
              { "text": "{{th_total_tax}}", "style": "th", "noWrap": true },
              { "text": "{{th_rebate}}", "style": "th", "noWrap": true },
              { "text": "{{th_penalty}}", "style": "th", "noWrap": true },
              { "text": "{{th_net_total}}", "style": "th", "noWrap": true }
            ],
            [
              { "text": "{{tax1_year}}",          "style": "td", "alignment": "center" },
              { "text": "{{tax1_propertyTax}}",   "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_samekitTax}}",    "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_educationCess}}", "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_waterCess}}",     "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_drainageCess}}",  "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_urbanDevCess}}",  "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_serviceCharge}}", "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_totalTax}}",      "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_rebate}}",        "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_penalty}}",       "style": "td", "alignment": "right", "font": "Roboto" },
              { "text": "{{tax1_netTotal}}",      "style": "td", "alignment": "right", "font": "Roboto" }
            ]
          ]
        },
        "layout": {}
      },

      {
        "margin": [0, 14, 0, 10],
        "canvas": [
          { "type": "line", "x1": 0, "y1": 0, "x2": 547, "y2": 0, "lineWidth": 0.7, "lineColor": "#BDBDBD" }
        ]
      },

      { "text": "OFFICE COPY", "alignment": "center", "style": "office-title", "margin": [0, 0, 0, 6] },
      {
        "style": "office-table",
        "table": {
          "widths": ["27%", "23%", "27%", "23%"],
          "dontBreakRows": true,
          "body": [
            [
              { "text": "{{receipt_no}}:", "style": "meta-label" },
              { "text": "{{receiptNo}}",   "style": "meta-value" },
              { "text": "{{payment_date}}:", "style": "meta-label" },
              { "text": "{{paymentDate}}", "style": "meta-value" }
            ],
            [
              { "text": "{{paid_amount}}:", "style": "meta-label" },
              { "text": "₹ {{paidAmount}}", "style": "meta-value" },
              { "text": "{{payment_mode}}:", "style": "meta-label" },
              { "text": "{{paymentMode}}",   "style": "meta-value" }
            ],
            [
              { "text": "{{transaction_id}}:", "style": "meta-label" },
              { "text": "{{transactionID}}",   "style": "meta-value" },
              { "text": "", "style": "meta-label" },
              { "text": "", "style": "meta-value" }
            ]
          ]
        },
        "layout": {},
        "margin": [0, 2, 0, 10]
      },

      {
        "columns": [
          { "text": "Cashier Signature", "style": "signature-left" },
          {
            "text": ["Cashier Name: ", { "text": "{{user-name}}", "bold": true }],
            "style": "signature-right",
            "alignment": "right"
          }
        ],
        "margin": [0, 2, 0, 6]
      },

      {
        "style": "pt-disclaimer",
        "stack": [
          { "text": "{{disclamer}}", "bold": true, "style": "pt-disclaimer-value" },
          {
            "style": "pt-disclaimer-value",
            "table": {
              "widths": ["100%"],
              "body": [
                [
                  {
                    "text": "{{disclaimerContent}}",
                    "border": [false, false, false, false],
                    "style": "pt-disclaimer-value"
                  }
                ]
              ]
            },
            "layout": {}
          }
        ]
      }
    ],

    "styles": {
      "header-title": { "fontSize": 14, "bold": true, "color": "#000000" },
      "header-subtitle": { "fontSize": 12, "color": "#000000", "margin": [0, 2, 0, 0] },
      "header-meta": { "fontSize": 10, "color": "#484848" },

      "meta-table": { "fontSize": 10.5, "margin": [0, 0, 0, 0] },
      "meta-label": { "bold": true, "color": "#000000", "margin": [2, 6, 2, 6] },
      "meta-value": { "color": "#000000", "margin": [2, 6, 2, 6] },

      "section-title": { "fontSize": 11, "bold": true, "margin": [0, 0, 0, 0] },

      "calcTable": { "fontSize": 10, "margin": [0, 0, 0, 0] },
      "taxTable":  { "fontSize": 10, "margin": [0, 0, 0, 0] },
      "th": { "bold": true, "alignment": "center", "margin": [4, 6, 4, 6] },
      "td": { "margin": [4, 6, 4, 6] },

      "office-title": { "fontSize": 11, "bold": true, "color": "#000000" },
      "office-table": { "fontSize": 10 },

      "signature-left":  { "fontSize": 10, "color": "#000000" },
      "signature-right": { "fontSize": 10, "color": "#000000" },

      "pt-disclaimer": { "fontSize": 10, "color": "#484848", "margin": [0, 6, 0, 0] },
      "pt-disclaimer-value": { "fontSize": 10, "color": "#484848", "margin": [0, 2, 0, 0] }
    }
  }
}