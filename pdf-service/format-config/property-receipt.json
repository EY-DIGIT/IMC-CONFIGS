{
  "key": "property-receipt",
  "config": {
    "pageSize": "A4",
    "pageMargins": [24, 22, 24, 22],

    "background": { "image": "{{logoImage}}", "opacity": 0.12, "width": 460 },

    "defaultStyle": { "font": "Cambay" },

    "content": [
      {
        "columns": [
          { "text": "Receipt/Acknowledgement", "style": "topline" },
          { "text": "Customer Copy {{paymentDate}}", "alignment": "right", "style": "topline" }
        ],
        "margin": [0, 0, 0, 10]
      },

      {
        "alignment": "center",
        "stack": [
          { "image": "{{finalHeaderImage}}", "width": 54, "height": 54, "margin": [0, 0, 0, 8] },
          { "text": "{{logo-header}} Nagar Nigam", "style": "header-title" },
          { "text": "Property Tax", "style": "header-subtitle" }
        ],
        "margin": [0, 0, 0, 6]
      },

      {
        "columns": [
          {
            "width": "52%",
            "stack": [
              { "text": "Municipal Act 1956 Sec. 186", "style": "info-line-muted", "margin": [0, 2, 0, 10] },
              { "text": [ "Receipt No : ", { "text": "{{receiptNo}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Property ID : ", { "text": "{{consumerID}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Property Owner Name : ", { "text": "{{payerName}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Address : ", { "text": "", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Zone/Ward : ", { "text": "", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Rate Zone : ", { "text": "", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Plot Area : ", { "text": "", "style": "info-value" } ], "style": "info-line" }
            ]
          },
          {
            "width": "48%",
            "alignment": "right",
            "stack": [
              { "text": [ "Date : ", { "text": "{{paymentDate}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Assessment Year : ", { "text": "{{fromPeriod}} {{to}} {{toPeriod}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Mobile No : ", { "text": "{{payerContact}}", "style": "info-value" } ], "style": "info-line" }
            ]
          }
        ],
        "margin": [0, 6, 0, 6]
      },

      { "text": "{{calcTableTitle}}", "style": "section-title", "margin": [0, 12, 0, 6] },
      {
        "style": "calcTable",
        "table": {
          "widths": ["12%", "10%", "10%", "15%", "10%", "10%", "10%", "13%", "10%"],
          "headerRows": 1,
          "keepWithHeaderRows": 1,
          "dontBreakRows": true,
          "body": [
            [
              { "text": "{{th_usage_type}}", "style": "th" },
              { "text": "{{th_usage_factor}}", "style": "th" },
              { "text": "{{th_floor_no}}", "style": "th" },
              { "text": "{{th_construction_type}}", "style": "th" },
              { "text": "{{th_area}}", "style": "th" },
              { "text": "{{th_rate}}", "style": "th" },
              { "text": "{{th_alv}}", "style": "th" },
              { "text": "{{th_maintenance}}", "style": "th" },
              { "text": "{{th_tpv}}", "style": "th" }
            ],
            [
              { "text": "{{calc1_usageType}}",      "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{calc1_usageFactor}}",    "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{calc1_floorNo}}",        "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{calc1_constructionType}}","style": "td","alignment": "left", "font": "Roboto" },
              { "text": "{{calc1_area}}",           "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{calc1_rate}}",           "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{calc1_alv}}",            "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{calc1_maintenance}}",    "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{calc1_tpv}}",            "style": "td", "alignment": "left", "font": "Roboto" }
            ]
          ]
        },
        "layout": {}
      },

      { "text": "{{taxTableTitle}}", "style": "section-title", "margin": [0, 12, 0, 6] },
      {
        "style": "taxTable",
        "table": {
          "widths": ["8%", "9%", "9%", "9%", "8%", "9%", "9%", "8%", "8%", "7%", "7%", "9%"],
          "headerRows": 1,
          "keepWithHeaderRows": 1,
          "dontBreakRows": true,
          "body": [
            [
              { "text": "{{th_year}}", "style": "th" },
              { "text": "{{th_property_tax}}", "style": "th" },
              { "text": "{{th_samekit_tax}}", "style": "th" },
              { "text": "{{th_education_cess}}", "style": "th" },
              { "text": "{{th_water_cess}}", "style": "th" },
              { "text": "{{th_drainage_cess}}", "style": "th" },
              { "text": "{{th_urban_dev_cess}}", "style": "th" },
              { "text": "{{th_service_charge}}", "style": "th" },
              { "text": "{{th_total_tax}}", "style": "th" },
              { "text": "{{th_rebate}}", "style": "th" },
              { "text": "{{th_penalty}}", "style": "th" },
              { "text": "{{th_net_total}}", "style": "th" }
            ],
            [
              { "text": "{{tax1_year}}",          "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_propertyTax}}",   "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_samekitTax}}",    "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_educationCess}}", "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_waterCess}}",     "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_drainageCess}}",  "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_urbanDevCess}}",  "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_serviceCharge}}", "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_totalTax}}",      "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_rebate}}",        "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_penalty}}",       "style": "td", "alignment": "left", "font": "Roboto" },
              { "text": "{{tax1_netTotal}}",      "style": "td", "alignment": "left", "font": "Roboto" }
            ]
          ]
        },
        "layout": {}
      },

      {
        "style": "office-table",
        "table": {
          "widths": ["25%", "25%", "25%", "25%"],
          "body": [
            [
              { "text": "Arrear :",                 "style": "meta-label" },
              { "text": "{{arrearAmt}}",            "style": "meta-value" },
              { "text": "Current Year Net Tax :",   "style": "meta-label" },
              { "text": "{{currentYearNetTax}}",    "style": "meta-value" }
            ],
            [
              { "text": "Total Amount Paid :",      "style": "meta-label" },
              { "text": "₹ {{paidAmount}}",         "style": "meta-value" },
              { "text": "Previous Balance :",       "style": "meta-label" },
              { "text": "{{previousBalance}}",      "style": "meta-value" }
            ],
            [
              { "text": "Cumulative Balance :",     "style": "meta-label" },
              { "text": "{{cumulativeBalance}}",    "style": "meta-value" },
              { "text": "Total Demand Payable :",   "style": "meta-label" },
              { "text": "{{totalDemandPayable}}",   "style": "meta-value" }
            ],
            [
              { "text": "Advance :",                "style": "meta-label" },
              { "text": "{{advanceAmt}}",           "style": "meta-value" },
              { "text": "Mode of Payment :",        "style": "meta-label" },
              { "text": "{{paymentMode}}",          "style": "meta-value" }
            ],
            [
              { "text": "Cheque Date :",            "style": "meta-label" },
              { "text": "{{chequeDate}}",           "style": "meta-value" },
              { "text": "Cheque Number :",          "style": "meta-label" },
              { "text": "{{chequeNumber}}",         "style": "meta-value" }
            ],
            [
              { "text": "Cheque Bank Name :",       "style": "meta-label" },
              { "text": "{{chequeBankName}}",       "style": "meta-value" },
              { "text": "",                         "style": "meta-label" },
              { "text": "",                         "style": "meta-value" }
            ]
          ]
        },
        "layout": {},
        "margin": [0, 10, 0, 6]
      },

      {
        "text": [
          "**This property tax receipt paid via cheque shall be acknowledged upon successful clearance of the cheque**\n\n",
          "**This receipt is not a proof of ownership**"
        ],
        "style": "pt-disclaimer-value",
        "margin": [0, 6, 0, 10]
      },

      {
        "columns": [
          { "text": "Cashier Signature Label", "style": "signature-left" },
          { "text": [ "Signature Placeholder ", { "text": "{{user-name}}", "bold": true } ], "style": "signature-right", "alignment": "right" }
        ],
        "margin": [0, 2, 0, 6]
      },

      {
        "margin": [0, 0, 0, 0],
        "canvas": [ { "type": "line", "x1": 0, "y1": 0, "x2": 547, "y2": 0, "lineWidth": 0.8, "lineColor": "#000000" } ]
      },
      { "text": "Office Copy", "alignment": "center", "style": "office-title", "margin": [0, 0, 0, 8] },

      {
        "columns": [
          {
            "width": "50%",
            "alignment": "left",
            "stack": [
              { "text": [ "Receipt No : ", { "text": "{{receiptNo}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Assessment Year : ", { "text": "{{fromPeriod}} {{to}} {{toPeriod}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Property ID : ", { "text": "{{consumerID}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Date : ", { "text": "{{paymentDate}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Property Owner Name : ", { "text": "{{payerName}}", "style": "info-value" } ], "style": "info-line" }
            ]
          },
          {
            "width": "50%",
            "alignment": "right",
            "stack": [
              { "text": [ "Address : ", { "text": "", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Zone/Ward : ", { "text": "", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Rate Zone : ", { "text": "", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Plot Area : ", { "text": "", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Total Amount Paid : ", { "text": "₹ {{paidAmount}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Mode of Payment : ", { "text": "{{paymentMode}}", "style": "info-value" } ], "style": "info-line" },
              { "text": [ "Transaction ID : ", { "text": "{{transactionID}}", "style": "info-value" } ], "style": "info-line" }
            ]
          }
        ],
        "margin": [0, 0, 0, 8]
      },

      {
        "columns": [
          { "text": "Cashier Signature", "style": "signature-left" },
          { "text": [ "Cashier Name: ", { "text": "{{user-name}}", "bold": true } ], "style": "signature-right", "alignment": "right" }
        ],
        "margin": [0, 2, 0, 6]
      },

      {
        "style": "pt-disclaimer",
        "stack": [
          { "text": "{{disclamer}}", "bold": true, "style": "pt-disclaimer-value" },
          {
            "style": "pt-disclaimer-value",
            "table": {
              "widths": ["100%"],
              "body": [
                [ { "text": "{{disclaimerContent}}", "border": [false, false, false, false], "style": "pt-disclaimer-value" } ]
              ]
            },
            "layout": {}
          }
        ]
      }
    ],

    "styles": {
      "topline": { "fontSize": 10, "color": "#484848" },
      "header-title": { "fontSize": 14, "bold": true, "color": "#000000" },
      "header-subtitle": { "fontSize": 12, "color": "#000000", "bold": true ,"margin": [0, 2, 0, 0] },

      "info-line": { "fontSize": 10.5, "margin": [0, 2, 0, 2], "color": "#000000" },
      "info-line-muted": { "fontSize": 10.5, "margin": [0, 0, 0, 2], "color": "#484848" },
      "info-value": { "bold": true },

      "section-title": { "fontSize": 11, "bold": true },

      "calcTable": { "fontSize": 10, "margin": [0, 0, 0, 0] },
      "taxTable":  { "fontSize": 10, "margin": [0, 0, 0, 0] },
      "th": { "bold": true, "alignment": "center", "margin": [4, 6, 4, 6] },
      "td": { "margin": [4, 6, 4, 6] },

      "office-title": { "fontSize": 11, "bold": true, "color": "#000000" },
      "signature-left":  { "fontSize": 10, "color": "#000000" },
      "signature-right": { "fontSize": 10, "color": "#000000" },

      "pt-disclaimer": { "fontSize": 10, "color": "#484848", "margin": [0, 6, 0, 0] },
      "pt-disclaimer-value": { "fontSize": 10, "color": "#484848", "margin": [0, 2, 0, 0] }
    }
  }
}