{
  "key": "pt-ledger",
  "config": {
    "pageSize": "A4",
    "pageMargins": [18, 15, 18, 15],
    "defaultStyle": { "font": "Cambay" },
    "content": [

      {
        "image": "{{logoImage}}",
        "width": 300,
        "absolutePosition": { "x": 150, "y": 200 }
      },
      {
        "columns": [
          { "text": "Ledger", "style": "topline" },
          { "text": "{{paymentDate}}", "alignment": "right", "style": "topline" }
        ],
        "margin": [0, 0, 0, 10]
      },

      {
        "alignment": "center",
        "stack": [
          { "text": "Indore Municipal Corporation", "style": "header-title" },
          { "text": "Property Tax", "style": "header-subtitle" },
          { "text": "Municipal Act 1956 Sec. 186", "style": "info-value" },
          { "text": "Ledger", "style": "ledger-title" }
        ],
        "margin": [0, 0, 0, 10]
      },

    

      { "text": "Dimension Details", "style": "section-title" },

     {
  "style": "infoTable",
  "margin": [0, 10, 0, 10],
  "table": {
    "widths": ["15%", "20%", "15%", "20%", "15%", "15%"],
    "body": [
      [
        { "text": "Property ID", "style": "th" },
        { "text": "{{propertyId}}", "style": "td" },
        { "text": "Old Property ID", "style": "th" },
        { "text": "{{oldPropertyId}}", "style": "td" },
        { "text": "Rate Zone", "style": "th" },
        { "text": "{{rateZone}}", "style": "td" }
      ],
      [
        { "text": "Owner Name", "style": "th" },
        { "text": "{{ownerName}}", "colSpan": 3, "style": "td" },
        { "text": "Connection Date", "style": "th"},
        { "text": "{{ownerName}}","style":"td"}
        
      ],
      [
        { "text": "Address", "style": "th" },
        { "text": "{{address}}", "colSpan": 3, "style": "td" },
        {}, {}, {}, {}
      ],
      [
        { "text": "Mobile No", "style": "th" },
        { "text": "{{mobileNumber}}", "style": "td" },
        { "text": "Email", "style": "th" },
        { "text": "{{email}}", "style": "td" },
        { "text": "Date", "style": "th" },
        { "text": "{{connectionDate}}", "style": "td" }
      ],
      [
        { "text": "Exemption", "style": "th" },
        { "text": "{{exemption}}", "colSpan": 3, "style": "td" },
        {}, {}, {}, {}
      ]
    ]
  }
},


      { "text": "Ledger (Year-wise)", "style": "section-title", "margin": [0, 8, 0, 4] },

      {
        "style": "taxTable",
        "table": {
          "widths": ["9%", "8%", "8%", "9%", "7%", "8%", "11%", "8%", "8%", "8%", "8%", "8%"],
          "headerRows": 1,
          "body": [
            [
              { "text": "{{th_year}}", "style": "th" },
              { "text": "{{th_property_tax}}", "style": "th" },
              { "text": "{{th_samekit_tax}}", "style": "th" },
              { "text": "{{th_education_cess}}", "style": "th" },
              { "text": "{{th_water_cess}}", "style": "th" },
              { "text": "{{th_drainage_cess}}", "style": "th" },
              { "text": "{{th_urban_dev_cess}}", "style": "th" },
              { "text": "{{th_service_charge}}", "style": "th" },
              { "text": "{{th_total_tax}}", "style": "th" },
              { "text": "{{th_rebate}}", "style": "th" },
              { "text": "{{th_penalty}}", "style": "th" },
              { "text": "{{th_net_total}}", "style": "th" }
            ],
            "{{#taxTableData}}[{\"text\":\"{{tax_year}}\",\"style\":\"td\"},{\"text\":\"{{tax_propertyTax}}\",\"style\":\"td\"},{\"text\":\"{{tax_samekitTax}}\",\"style\":\"td\"},{\"text\":\"{{tax_educationCess}}\",\"style\":\"td\"},{\"text\":\"{{tax_waterCess}}\",\"style\":\"td\"},{\"text\":\"{{tax_drainageCess}}\",\"style\":\"td\"},{\"text\":\"{{tax_urbanDevCess}}\",\"style\":\"td\"},{\"text\":\"{{tax_serviceCharge}}\",\"style\":\"td\"},{\"text\":\"{{tax_totalTax}}\",\"style\":\"td\"},{\"text\":\"{{tax_rebate}}\",\"style\":\"td\"},{\"text\":\"{{tax_penalty}}\",\"style\":\"td\"},{\"text\":\"{{tax_netTotal}}\",\"style\":\"td\"}]{{/taxTableData}}"
          ]
        }
      },

      { "text": "Summary Ledger", "style": "section-title", "margin": [0, 8, 0, 4] },

      {
        "style": "office-columns-block",
        "columns": [
          { "width": "25%", "text": ["Arrear : ", { "text": "{{arrearAmt}}", "style": "meta-value" }] },
          { "width": "25%", "text": ["Current Year : ", { "text": "{{currentYearNetTax}}", "style": "meta-value" }] },
          { "width": "25%", "text": ["Paid Amount : ₹ ", { "text": "{{paidAmount}}", "style": "meta-value" }] },
          { "width": "25%", "text": ["Balance : ", { "text": "{{cumulativeBalance}}", "style": "meta-value" }] }
        ]
      }
    ],

    "styles": {
      "topline": { "fontSize": 10, "color": "#484848" },
      "header-title": { "fontSize": 15,"bold": true, "color": "#000000", "margin": [0, -3, 0, 0] },
      "header-subtitle": { "fontSize": 13,"bold": true, "color": "#000000", "margin": [0, 2, 0, 0] },
      "ledger-title": { "fontSize": 14, "bold": true, "margin": [0, 4, 0, 2] },
      "ledger-date": { "fontSize": 9, "color": "#484848" },
      "info-block": { "fontSize": 10 },
      "section-title": { "fontSize": 10, "bold": true }
    }
  }
}
