{
  "key": "pt-ledger",
  "config": {
 
    
  "pageSize": "A4",
  "pageMargins": [30, 30, 30, 30],

  "defaultStyle": {
    "fontSize": 9
  },

  "styles": {
    "topline": { "fontSize": 8 },
    "header-title": { "fontSize": 14, "bold": true },
    "header-subtitle": { "fontSize": 11, "bold": true },
    "section-title": { "fontSize": 10, "bold": true },
    "th": { "bold": true },
    "td": {},
    "calcTable": {
      "margin": [0, 0, 0, 10]
    }
  },

  "content": [

    

    {
      "columns": [
        { "text": "Ledger", "style": "topline" },
        { "text": "{{currentDate}}", "style": "topline", "alignment": "right" }
      ],
      "margin": [0, 0, 0, 8]
    },


    {
      "alignment": "center",
      "stack": [
        { "text": "Indore Municipal Corporation", "style": "header-title" },
        { "text": "Property Tax", "style": "header-subtitle" },
        { "text": "Municipal Act 1956 Sec. 186" },
        { "text": "Ledger" }
      ],
      "margin": [0, 0, 0, 10]
    },


    {
      "style": "calcTable",
      "table": {
        "widths": ["15%", "18%", "15%", "18%", "15%", "19%"],
        "body": [
          [
            { "text": "Property ID", "style": "th" },
            { "text": "{{consumerID}}", "style": "td" },
            { "text": "Old Property ID", "style": "th" },
            { "text": "{{oldPropertyId}}", "style": "td" },
            { "text": "Rate Zone", "style": "th" },
            { "text": "{{rateZone}}", "style": "td" }
          ],
          [
            { "text": "Owner Name", "style": "th" },
            { "text": "{{payerName}}", "style": "td" },
            { "text": "Connection Date", "style": "th" },
            { "text": "{{connectionDate}}", "style": "td" },
            { "text": "", "style": "th" },
            { "text": "", "style": "td" }
          ],
          [
            { "text": "Address", "style": "th" },
            { "text": "{{ptAddress}}", "colSpan": 3, "style": "td" },
            {},
            {},
            { "text": "Zone/Ward", "style": "th" },
            { "text": "{{zone}}/{{ward}}", "style": "td" }
          ],
          [
            { "text": "Mobile No", "style": "th" },
            { "text": "{{mobileNumber}}", "style": "td" },
            { "text": "Email", "style": "th" },
            { "text": "{{email}}", "style": "td" },
            { "text": "Date", "style": "th" },
            { "text": "{{currentDate}}", "style": "td" }
          ],
          [
            { "text": "Exemption", "style": "th" },
            { "text": "{{exemption}}", "style": "td" },
            { "text": "", "style": "th" },
            { "text": "", "style": "td" },
            { "text": "", "style": "th" },
            { "text": "", "style": "td" }
          ]
        ]
      }
    },


    {
      "text": "Dimension Details",
      "style": "section-title",
      "alignment": "center",
      "margin": [0, 5, 0, 5]
    },

    {
  "style": "calcTable",
  "table": {
    "headerRows": 1,
    "widths": ["11%", "11%", "9%", "14%", "9%", "9%", "9%", "10%", "9%"],
    "body": [
      [
        { "text": "Usage Type", "style": "th" },
        { "text": "Usage Factor", "style": "th" },
        { "text": "Floor No.", "style": "th" },
        { "text": "Construction Type", "style": "th" },
        { "text": "Area", "style": "th" },
        { "text": "Rate", "style": "th" },
        { "text": "ALV", "style": "th" },
        { "text": "Maintenance Discount", "style": "th" },
        { "text": "TPV", "style": "th" }
      ],
      "{{#calcTableData}}[{\"text\":\"{{usageType}}\",\"style\":\"td\"},{\"text\":\"{{usageFactor}}\",\"style\":\"td\"},{\"text\":\"{{floorNo}}\",\"style\":\"td\"},{\"text\":\"{{constructionType}}\",\"style\":\"td\"},{\"text\":\"{{area}}\",\"style\":\"td\"},{\"text\":\"{{rate}}\",\"style\":\"td\"},{\"text\":\"{{alv}}\",\"style\":\"td\"},{\"text\":\"{{maintenanceDiscount}}\",\"style\":\"td\"},{\"text\":\"{{tpv}}\",\"style\":\"td\"}]{{/calcTableData}}"
    ]
  }
},



    {
      "text": "Summary Ledger",
      "style": "section-title",
      "alignment": "center",
      "margin": [0, 8, 0, 5]
    },

    {
  "style": "calcTable",
  "table": {
    "headerRows": 1,
    "widths": ["25%", "25%", "25%", "25%"],
    "body": [
      [
        { "text": "Year", "style": "th" },
        { "text": "Demand", "style": "th" },
        { "text": "Collection / Paid", "style": "th" },
        { "text": "Cumulative Balance", "style": "th" }
      ],
      "{{#summaryLedger}}[{\"text\":\"{{year}}\",\"style\":\"td\"},{\"text\":\"{{demand}}\",\"style\":\"td\"},{\"text\":\"{{paid}}\",\"style\":\"td\"},{\"text\":\"{{balance}}\",\"style\":\"td\"}]{{/summaryLedger}}"
    ]
  }
}


  ]
}

  }

