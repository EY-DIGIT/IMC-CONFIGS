{
  "key": "pt-detailedledger-hindi",
  "config": {
    "pageSize": "A4",
    "pageOrientation": "landscape",

    "pageMargins": [18, 15, 18, 15],
    "defaultStyle": { "font": "Cambay" },
    "content": [

      {
        "image": "{{logoImage}}",
        "width": 300,
        "absolutePosition": { "x": 250, "y": 200 }
      },
      {
        "columns": [
          { "text": "Detailed Ledger Report", "style": "topline" },
          { "text": "{{paymentDate}}", "alignment": "right", "style": "topline" }
        ],
        "margin": [0, 0, 0, 10]
      },

      {
        "alignment": "center",
        "stack": [
          { "text": "Indore Municipal Corporation", "style": "header-title" },
          { "text": "Property Tax", "style": "header-subtitle" },
          { "text": "Municipal Act 1956 Sec. 186", "style": "info-value" },
          { "text": "Detailed Ledger Report", "style": "ledger-title" }
        ],
        "margin": [0, 0, 0, 10]
      },

  
     {
  "style": "infoTable",
  "margin": [0, 10, 0, 10],
  "table": {
    "widths": ["15%", "20%", "15%", "20%", "15%", "15%"],
    "body": [
      [
        { "text": "संपत्ति आईडी", "style": "th" },
        { "text": "{{consumerID}}", "style": "td" },
        { "text": "Old Property ID", "style": "th" },
        { "text": "{{oldpropertyid}}", "style": "td" },
        { "text": "दर क्षेत्र", "style": "th" },
        { "text": "{{rateZone}}", "style": "td" }
      ],
      [
        { "text": "स्वामी का नाम", "style": "th" },
        { "text": "{{payerName}}", "colSpan": 3, "style": "td" },
        {},
        {},
        { "text": "Connection Date", "style": "th" },
        { "text": "{{paymentDate}}", "style": "td" }
      ],
      [
        { "text": "पता", "style": "th" },
        { "text": "{{ptAddress}}", "colSpan": 3, "style": "td" },
        {}, 
        {},
        { "text": "झोन/वार्ड", "style": "th" },
        { "text": "{{zone}} / {{ward}}", "style": "td" }

      ],
      [
        { "text": "मोबाइल नंबर", "style": "th" },
        { "text": "{{payerContact}}", "colSpan": 2, "style": "td" },
        {},
        { "text": "ईमेल आईडी", "style": "th" },
        { "text": "{{ownerEmail}}", "colSpan": 2, "style": "td" },
        {}
        
      ],
      [
        { "text": "छूट", "style": "th" },
        { "text": "{{}}", "colSpan": 3, "style": "td" },
        {}, {}, 
        { "text": "दिनांक", "style": "th" },
        { "text": "{{paymentDate}}",  "style": "td" }

      ]
    ]
  }
},



      {
  "style": "calcTable",
  "margin": [0, 0, 0, 10],
  "table": {
    "widths": ["14%", "15%", "9%", "14%", "9%", "8%", "9%", "14%", "8%"],
    "headerRows": 2,
    "keepWithHeaderRows": 1,
    "dontBreakRows": true,
    "body": [
      [
        {
          "text": "Dimension Details",
          "style": "tableHeader",
          "colSpan": 9,
          "alignment": "center",
          "bold": true
        },
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {}
      ],
      [
        { "text": "उपयोग प्रकार", "style": "th" },
        { "text": "उपयोग गुणांक", "style": "th" },
        { "text": "मंज़िल संख्या", "style": "th" },
        { "text": "निर्माण का प्रकार", "style": "th" },
        { "text": "क्षेत्रफल (वर्ग फुट में)", "style": "th" },
        { "text": "दर", "style": "th" },
        { "text": "वार्षिक भाड़ा मूल्य", "style": "th" },
        { "text": "रखरखाव छूट", "style": "th" },
        { "text": "प्राप्त वार्षिक भाड़ा मूल्य", "style": "th" }
      ],
      "{{#calcTableData}}[{\"text\":\"{{calc_usageType}}\",\"style\":\"td\"},{\"text\":\"{{calc_usageFactor}}\",\"style\":\"td\"},{\"text\":\"{{calc_floorNo}}\",\"style\":\"td\"},{\"text\":\"{{calc_constructionType}}\",\"style\":\"td\"},{\"text\":\"{{calc_area}}\",\"style\":\"td\"},{\"text\":\"₹ {{calc_rate}}\",\"style\":\"td\"},{\"text\":\"₹ {{calc_alv}}\",\"style\":\"td\"},{\"text\":\"₹ {{maintainance_discount}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_tpv}}\",\"style\":\"td\"}]{{/calcTableData}}"
    ]
  },
  "layout": {}
},
     {
  "style": "taxTable",
  "margin": [0, 0, 0, 10],
  "table": {
    "widths": ["6%", "7%", "7%", "7%", "6%", "7%", "7%", "7%", "7%", "6%", "6%", "7%", "7%", "7%", "6%"],
    "headerRows": 2,
    "keepWithHeaderRows": 1,
    "dontBreakRows": true,
    "body": [
      [
        {
          "text": "Summary Ledger",
          "style": "tableHeader",
          "colSpan": 15,
          "alignment": "center",
          "bold": true
        },
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {},
        {}
      ],
      [
        { "text": "Year", "style": "th" },
        { "text": "Property Tax", "style": "th" },
        { "text": "Consolidated Tax", "style": "th" },
        { "text": "Education Cess", "style": "th" },
        { "text": "Water Cess", "style": "th" },
        { "text": "Drainage Cess", "style": "th" },
        { "text": "Urban Development Cess", "style": "th" },
        { "text": "Service Charge", "style": "th" },
        { "text": "Total Tax", "style": "th" },
        { "text": "Penalty", "style": "th" },
        { "text": "Rebate", "style": "th" },
        { "text": "Lok Adalat Discount", "style": "th" },
        { "text": "Net Tax", "style": "th" },
        { "text": "Collection/Paid", "style": "th" },
        { "text": "Cumulative Balance", "style": "th" }
      ],
            "{{#taxTableData}}[{\"text\":\"{{tax_year}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_propertyTax}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_samekitTax}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_educationCess}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_waterCess}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_drainageCess}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_urbanDevCess}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_serviceCharge}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_totalTax}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_penalty}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_rebate}}\",\"style\":\"td\"},{\"text\":\"₹ {{lokadalat}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_netTotal}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_paid}}\",\"style\":\"td\"},{\"text\":\"₹ {{tax_cumulative}}\",\"style\":\"td\"}]{{/taxTableData}}"
    ]
  },
  "layout": {}
}

     

      
    ],

    "styles": {
      "topline": { "fontSize": 10, "color": "#484848" },
      "header-title": { "fontSize": 17,"bold": true, "color": "#000000", "margin": [0, -3, 0, 0] },
      "header-subtitle": { "fontSize": 14,"bold": true, "color": "#000000", "margin": [0, 2, 0, 0] },
      "ledger-title": { "fontSize": 14, "bold": true, "margin": [0, 4, 0, 2] },
      "ledger-date": { "fontSize": 9, "color": "#484848" },
      "info-block": { "fontSize": 10 },
      "section-title": { "fontSize": 10, "bold": true },
      "th": { "fontSize": 7,"bold": true, "margin": [2, 3, 2, 3] },
      "td": { "fontSize": 7, "margin": [2, 3, 2, 3] }
    }
  }
}